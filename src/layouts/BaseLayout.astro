---
import { ClientRouter } from 'astro:transitions';
import VariantSwitcher from '../components/VariantSwitcher.astro';
import '../styles/base.css';
import '../styles/themes/variant-a.css';
import '../styles/themes/variant-b.css';
import '../styles/themes/variant-c.css';

interface Props {
  title: string;
  bodyClass?: string;
}
const { title, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en" data-body-class={bodyClass ?? ''} data-variant="a">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/icons/swyrlogowhite.svg" />
    <!-- Design variant (a | b | c): ?variant= wins, then localStorage, else "a".
         Runs before first paint so there is no flash of the wrong theme. -->
    <script is:inline>
      (function () {
        var ok = /^[abc]$/;
        var v = null;
        try {
          var q = new URLSearchParams(location.search).get('variant');
          if (q && ok.test(q)) v = q;
        } catch (e) {}
        try {
          if (v) localStorage.setItem('swyr-variant', v);
          else v = localStorage.getItem('swyr-variant');
        } catch (e) {}
        if (!v || !ok.test(v)) v = 'a';
        document.documentElement.dataset.variant = v;
        if (!window.__swyrVariantHook) {
          window.__swyrVariantHook = true;
          // ClientRouter replaces <html> attributes on navigation; carry the variant over.
          document.addEventListener('astro:before-swap', function (e) {
            e.newDocument.documentElement.dataset.variant =
              document.documentElement.dataset.variant;
          });
        }
      })();
    </script>
    <slot name="head" />
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <slot />
    <VariantSwitcher />
    <script>
      // Keep body class in sync after every client-side navigation.
      // Astro's ClientRouter doesn't always propagate <body> attribute changes
      // from the incoming page, so we re-apply the class from a data attribute
      // stamped on <html> by each layout.
      function syncBodyClass() {
        const next = document.documentElement.dataset.bodyClass;
        document.body.className = next || '';
      }
      document.addEventListener('astro:after-swap', syncBodyClass);
    </script>
  </body>
</html>
