---
import SiteNav from '../components/LandingNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}
const { title, description, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/icons/swyrlogowhite.svg" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <SiteNav />
    <slot />
    <SiteFooter />
    <script is:inline src="/js/nav.js" defer></script>
    <script is:inline src="/js/flair.js" defer></script>
  </body>
</html>
