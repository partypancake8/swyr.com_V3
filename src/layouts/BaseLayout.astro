---
import SiteNav from '../components/LandingNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}
const { title, description, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/icons/swyrlogowhite.svg" />
    <script is:inline>
      // Motion is on by default regardless of the OS setting; the footer toggle
      // stores an explicit opt-out in localStorage "swyr-motion".
      (function () {
        var d = document.documentElement, m = 'on';
        d.classList.add('js');
        try { if (localStorage.getItem('swyr-motion') === 'off') m = 'off'; } catch (e) {}
        d.setAttribute('data-motion', m);
      })();
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <SiteNav />
    <slot />
    <SiteFooter />
    <script is:inline src="/js/nav.js" defer></script>
    <script is:inline src="/js/flair.js" defer></script>
  </body>
</html>
