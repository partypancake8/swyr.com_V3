---
import BaseLayout from './BaseLayout.astro';
import Pane from '../components/Pane.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Sawyer Smith — Robotics Engineer & Full-Stack Developer">
  <div class="layout">
    <Pane />
    <main id="main" class="content">
      <slot />
      <SiteFooter />
    </main>
  </div>

  <script is:inline src="/js/main.js"></script>
</BaseLayout>

<style>
  .layout {
    min-height: 100vh;
  }

  .content {
    margin-left: var(--pane-w);
    padding: var(--space-2xl) clamp(var(--space-md), 5vw, var(--space-2xl));
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  @media (max-width: 1024px) {
    .content {
      margin-left: 0;
      padding: var(--space-xl) var(--space-md) var(--space-lg);
      gap: var(--space-xl);
    }
  }
</style>
