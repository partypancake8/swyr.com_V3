---
import BaseLayout from './BaseLayout.astro';
import '../styles/project.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  /** Kept for backwards compatibility; the nav now derives the breadcrumb from the URL. */
  breadcrumb?: string;
}
const { title } = Astro.props;
---

<BaseLayout title={title}>
  <main class="proj-page">
    <slot />

    <aside class="page-links">
      <a href="https://github.com/partypancake8/" target="_blank" rel="noopener" aria-label="GitHub">
        <Icon name="github" size={18} class="icon-svg" />
      </a>
      <a href="https://www.linkedin.com/in/sawyer-smith-60918a221/" target="_blank" rel="noopener" aria-label="LinkedIn">
        <Icon name="linkedin" size={18} class="icon-svg" />
      </a>
      <a class="page-links__email" href="mailto:swyr@swyr.com"><Icon name="mail" />swyr@swyr.com</a>
    </aside>
  </main>
</BaseLayout>
