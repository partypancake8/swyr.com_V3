---
import BaseLayout from './BaseLayout.astro';
import LandingNav from '../components/LandingNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/project.css';

interface Props {
  title: string;
  breadcrumb?: string;
}
const { title, breadcrumb } = Astro.props;
---

<BaseLayout title={title}>
  <LandingNav breadcrumb={breadcrumb} />

  <div class="proj-page">
    <slot />

    <aside class="page-links">
      <a href="https://github.com/partypancake8/" target="_blank" rel="noopener" aria-label="GitHub">
        <span class="icon" style="--icon: url(/icons/github.svg)" aria-hidden="true"></span>
      </a>
      <a href="https://www.linkedin.com/in/sawyer-smith-60918a221/" target="_blank" rel="noopener" aria-label="LinkedIn">
        <span class="icon" style="--icon: url(/icons/linkedin.svg)" aria-hidden="true"></span>
      </a>
      <a class="page-links__email" href="mailto:swyr@swyr.com">swyr@swyr.com</a>
    </aside>
  </div>
  <SiteFooter />
</BaseLayout>
