---
// The one site header, used by every page through BaseLayout.
// Section links always use absolute "/#id" hrefs: on the landing page the
// browser scrolls in place (smooth, offset by scroll-margin-top); on sub-pages
// it loads "/" and jumps to the section. No client router is involved.
const path = Astro.url.pathname.replace(/\/+$/, '');
const segs = path.split('/').filter(Boolean);
// Parent crumbs link back to where that group lives on the landing page.
const parentHref: Record<string, string> = { projects: '/#work', work: '/#experience' };
const crumbs = segs.map((seg, i) => ({
  text: seg,
  href: i === segs.length - 1 ? '#' : parentHref[seg] ?? '/' + segs.slice(0, i + 1).join('/'),
  top: i === segs.length - 1,
}));
const links = [
  { id: 'work', label: 'Work', index: '01.', icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>' },
  { id: 'experience', label: 'Experience', index: '02.', icon: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>' },
  { id: 'about', label: 'About', index: '03.', icon: '<circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>' },
  { id: 'contact', label: 'Contact', index: '04.', icon: '<rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2 4 12 13 22 4"/>' },
];
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <div class="site-header__left">
      <a class="site-header__logo" href="/" aria-label="Sawyer Smith, home">
        <span class="logo-sprite" aria-hidden="true"></span>
      </a>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <span class="breadcrumb__inner">
          <a class="breadcrumb__crumb" href="/" data-scroll-top={segs.length === 0 ? '' : undefined}>swyr</a>
          {crumbs.map((c) => (
            <span class="breadcrumb__part">
              <span class="breadcrumb__sep" aria-hidden="true">/</span>
              <a class="breadcrumb__crumb" href={c.href} data-scroll-top={c.top ? '' : undefined}>{c.text}</a>
            </span>
          ))}
          <span class="breadcrumb__live" data-crumb-live></span>
        </span>
      </nav>
    </div>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav-panel"
      aria-label="Open menu"
      data-nav-toggle
    >
      <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <nav class="site-nav" id="site-nav-panel" aria-label="Main" data-nav-panel>
      <ul class="site-nav__list">
        <li class="site-nav__indicator" aria-hidden="true"></li>
        {links.map((l) => (
          <li>
            <a class="site-nav__link" href={`/#${l.id}`} data-section-link={l.id}>
              <svg class="site-nav__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={l.icon} />
              <span><span class="nav-index">{l.index}</span> {l.label}</span>
            </a>
          </li>
        ))}
        <li>
          <a class="site-nav__link site-nav__resume" href="/documents/Sawyer Smith Resume 2025.pdf" target="_blank" rel="noopener">
            <svg class="site-nav__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span>Resume</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <span class="site-header__progress" aria-hidden="true"></span>
</header>
