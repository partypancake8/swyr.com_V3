---
// The one site header, used by every page through BaseLayout: logo, live
// breadcrumb and a single Resume link. Parent crumbs use absolute "/#id" hrefs:
// on sub-pages they load "/" and jump to the section. No client router is involved.
import Icon from './Icon.astro';
const path = Astro.url.pathname.replace(/\/+$/, '');
const segs = path.split('/').filter(Boolean);
// Parent crumbs link back to where that group lives on the landing page.
const parentHref: Record<string, string> = { projects: '/#projects', work: '/#experience' };
const crumbs = segs.map((seg, i) => ({
  text: seg,
  href: i === segs.length - 1 ? '#' : parentHref[seg] ?? '/' + segs.slice(0, i + 1).join('/'),
  top: i === segs.length - 1,
}));
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <div class="site-header__left">
      <a class="site-header__logo" href="/" aria-label="Sawyer Smith, home">
        <span class="logo-sprite" aria-hidden="true"></span>
      </a>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <span class="breadcrumb__inner">
          <a class="breadcrumb__crumb" href="/" data-scroll-top={segs.length === 0 ? '' : undefined}>swyr</a>
          {crumbs.map((c) => (
            <span class="breadcrumb__part">
              <span class="breadcrumb__sep" aria-hidden="true">/</span>
              <a class="breadcrumb__crumb" href={c.href} data-scroll-top={c.top ? '' : undefined}>{c.text}</a>
            </span>
          ))}
          <span class="breadcrumb__live" data-crumb-live></span>
        </span>
      </nav>
    </div>

    <nav class="site-nav" aria-label="Main">
      <a class="site-nav__resume" href="/resume" aria-current={path === '/resume' ? 'page' : undefined}>
        <Icon name="file" class="site-nav__icon" />
        <span>Resume</span>
      </a>
    </nav>
  </div>
  <span class="site-header__progress" aria-hidden="true"></span>
</header>
