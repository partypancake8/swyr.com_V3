---
// The site's one icon set, drawn for swyr.com. Inline SVG, currentColor, no requests.
// Smooth line family: 24-unit viewBox, 1.5 stroke, round caps and joins (plus the
// filled GitHub mark). The only pixel art on the site is the swyrbot and the footer
// invaders, which live outside this component.
// Usage: <Icon name="star" size={16} /> ; pass `label` to make it meaningful
// (role="img"), otherwise it is decorative and aria-hidden.

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}

const LINE = {
