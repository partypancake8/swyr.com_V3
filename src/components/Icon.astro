  camera: '<path d="M4 8.5A1.5 1.5 0 0 1 5.5 7h2.25l1.5-2.25h5.5L16.25 7h2.25A1.5 1.5 0 0 1 20 8.5V18a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18Z"/><circle cx="12" cy="13" r="3.5"/>',
  rocket: '<path d="M12 3c2.9 2.2 4.5 5.4 4.5 9.4V16h-9v-3.6C7.5 8.4 9.1 5.2 12 3Z"/><circle cx="12" cy="10" r="1.6"/><path d="M7.5 12.5 5 15.25V18.5l2.5-2.25M16.5 12.5l2.5 2.75V18.5l-2.5-2.25M10.5 19v2M13.5 19v2"/>',
