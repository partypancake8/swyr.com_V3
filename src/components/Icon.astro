---
// The site's one icon set, drawn for swyr.com. Inline SVG, currentColor, no requests.
//  - Pixel family: hand-placed cells on an 8x8 grid (the tiny invader is 6x6),
//    rendered as merged <rect> runs with crispEdges. The viewBox is padded so each
//    cell lands on whole device pixels at 16, 20 and 24px.
//  - Line family: 24-unit viewBox, 1.5 stroke, round caps and joins.
// Usage: <Icon name="px-star" size={16} /> ; pass `label` to make it meaningful
// (role="img"), otherwise it is decorative and aria-hidden.

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}

