// GitHub's published mark (their brand asset for linking to GitHub), filled.
const GITHUB =
  'M12 0C5.37 0 0 5.37 0 12C0 17.31 3.435 21.795 8.205 23.385C8.805 23.49 9.03 23.13 9.03 22.815C9.03 22.53 9.015 21.585 9.015 20.58C6 21.135 5.22 19.845 4.98 19.17C4.845 18.825 4.26 17.76 3.75 17.475C3.33 17.25 2.73 16.695 3.735 16.68C4.68 16.665 5.355 17.55 5.58 17.91C6.66 19.725 8.385 19.215 9.075 18.9C9.18 18.12 9.495 17.595 9.84 17.295C7.17 16.995 4.38 15.96 4.38 11.37C4.38 10.065 4.845 8.985 5.61 8.145C5.49 7.845 5.07 6.615 5.73 4.965C5.73 4.965 6.735 4.65 9.03 6.195C9.99 5.925 11.01 5.79 12.03 5.79C13.05 5.79 14.07 5.925 15.03 6.195C17.325 4.635 18.33 4.965 18.33 4.965C18.99 6.615 18.57 7.845 18.45 8.145C19.215 8.985 19.68 10.05 19.68 11.37C19.68 15.975 16.875 16.995 14.205 17.295C14.64 17.67 15.015 18.39 15.015 19.515C15.015 21.12 15 22.41 15 22.815C15 23.13 15.225 23.505 15.825 23.385C18.2073 22.581 20.2775 21.05 21.744 19.0076C23.2106 16.9653 23.9996 14.5144 24 12C24 5.37 18.63 0 12 0Z';

export type IconName = keyof typeof LINE | 'github';

const { name, size = 16, class: cls, label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true', focusable: 'false' };

let kind: 'line' | 'mark';
const viewBox = '0 0 24 24';
let body = '';
if (name === 'github') {
  kind = 'mark';
  body = `<path d="${GITHUB}"/>`;
} else {
  kind = 'line';
  body = LINE[name as keyof typeof LINE] ?? '';
}
const classes = ['ico', `ico--${kind}`, `ico-${name}`, cls].filter(Boolean).join(' ');
---

{kind === 'line' && (
  <svg class={classes} width={size} height={size} viewBox={viewBox} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" {...a11y} set:html={body} />
)}
{kind === 'mark' && (
  <svg class={classes} width={size} height={size} viewBox={viewBox} fill="currentColor" {...a11y} set:html={body} />
)}
