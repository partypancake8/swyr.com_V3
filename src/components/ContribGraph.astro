---
// GitHub contribution history drawn in the shape of the swyr pixel invader.
// About 70% of the invader's cells are lit; each lit cell is a real day with at
// least one contribution from src/data/contributions.json, in GitHub order
// (column by column left to right, top to bottom, oldest first, so the newest
// day is the bottom-right-most lit cell). The other cells stay dark so the body
// still reads as a solid shape. Static SVG built at compile time, no animation.
import data from '../data/contributions.json';
import Icon from './Icon.astro';

// 21 x 20: the 42 x 40 pixel logo downsampled 2x2, with the S hand-fixed
// so each stroke is one cell wide and reads cleanly at this size.
const MATRIX = [
  '....##.........##....',
  '....##.........##....',
  '......##.....##......',
  '......##.....##......',
  '....#############....',
  '....#############....',
  '..#####.......#####..',
  '..#####.#####.#####..',
  '#######.#.....#######',
  '#######.#####.#######',
  '#######.....#.#######',
  '#######.#####.#######',
  '##..###.......###..##',
  '##..#############..##',
  '##..#############..##',
  '##..#############..##',
  '......##.....##......',
  '......##.....##......',
  '....##.........##....',
  '....##.........##....',
];
const LEVELS = ['#161b22', '#0e4429', '#006d32', '#26a641', '#39d353'];
const CELL = 14;
const GAP = 3;
const STEP = CELL + GAP;
const LIT_SHARE = 0.7;
const MONTH_LONG = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

const cols = MATRIX[0].length;
const rows = MATRIX.length;
const width = cols * STEP - GAP;
const height = rows * STEP - GAP;
const isCell = (x: number, y: number) => y >= 0 && y < rows && x >= 0 && x < cols && MATRIX[y][x] === '#';

// Silhouette cells in GitHub order (column-major, top to bottom).
const slots: { x: number; y: number }[] = [];
for (let x = 0; x < cols; x++) for (let y = 0; y < rows; y++) if (isCell(x, y)) slots.push({ x, y });

// Gap mask: deterministic, weighted toward the thick body. Cells with 2 or fewer
// silhouette neighbours (tips, strokes, feet, corners) and the arm and leg rows
// (0 to 3, 16 to 19) are never gaps; 3-neighbour edge cells rarely are; 4-neighbour
// body cells take most of them. A gap may touch at most one other gap (isolated
// dead pixels or pairs, never runs of three, L shapes or blocks), so every stroke
// stays whole.
const N4 = [[1, 0], [-1, 0], [0, 1], [0, -1]];
const nbrs = (x: number, y: number) => N4.filter(([dx, dy]) => isCell(x + dx, y + dy)).length;
function hash(x: number, y: number) {
  let h = (Math.imul(x + 1, 374761393) + Math.imul(y + 1, 668265263)) | 0;
  h = Math.imul(h ^ (h >>> 13), 1274126177);
  h ^= h >>> 16;
  return (h >>> 0) / 4294967296;
}
function gapWeight(x: number, y: number) {
  const n = nbrs(x, y);
  if (n <= 2 || y <= 3 || y >= rows - 4) return 0;
  return n === 4 ? 1 : 0.3;
}
const litCount = Math.round(LIT_SHARE * slots.length);
const gapCount = slots.length - litCount;
const gaps = new Set<string>();
const gapNbrs = (x: number, y: number) => N4.map(([dx, dy]) => [x + dx, y + dy]).filter(([gx, gy]) => gaps.has(`${gx},${gy}`));
const ranked = slots
  .map((s) => ({ ...s, score: gapWeight(s.x, s.y) * hash(s.x, s.y) }))
  .filter((s) => s.score > 0)
  .sort((a, b) => b.score - a.score);
for (const s of ranked) {
  if (gaps.size >= gapCount) break;
  const g = gapNbrs(s.x, s.y);
  if (g.length === 0 || (g.length === 1 && gapNbrs(g[0][0], g[0][1]).length === 0)) gaps.add(`${s.x},${s.y}`);
}
const litSlots = slots.filter((s) => !gaps.has(`${s.x},${s.y}`));
console.log(`[ContribGraph] mask ${litSlots.length}/${slots.length} lit (${(litSlots.length / slots.length).toFixed(3)}), # lit . gap\n` +
  MATRIX.map((row, y) => [...row].map((c, x) => (c !== '#' ? ' ' : gaps.has(`${x},${y}`) ? '.' : '#')).join('')).join('\n'));

type Day = { date: string; count: number; level: number };
const active = ((data as { days?: Day[] }).days ?? [])
  .filter((d) => d.count > 0)
  .sort((a, b) => a.date.localeCompare(b.date));
// One lit cell per active day, newest days kept. If history has fewer active days
// than lit cells, every active day is shown and the spare cells are shared out by
// count (largest remainder, at least one each), so a busy day spans a short run of
// adjacent cells that all carry that same day's tooltip. No lit cell is ever a
// zero-contribution day.
const shown = active.slice(-litSlots.length);
const runs = shown.map(() => 1);
const spare = litSlots.length - shown.length;
if (spare > 0 && shown.length) {
  const sum = shown.reduce((s, d) => s + d.count, 0);
  const exact = shown.map((d) => (spare * d.count) / sum);
  exact.forEach((e, i) => (runs[i] += Math.floor(e)));
  let left = litSlots.length - runs.reduce((a, b) => a + b, 0);
  const order = exact.map((e, i) => ({ i, r: e - Math.floor(e) })).sort((a, b) => b.r - a.r || b.i - a.i);
  for (let k = 0; left > 0; k++, left--) runs[order[k % order.length].i]++;
}

// Colour by quantile over the shown days: top 40% brightest, then 30%, 20%, 10%.
const counts = shown.map((d) => d.count).sort((a, b) => a - b);
function levelFor(count: number) {
  const below = counts.filter((c) => c < count).length / Math.max(1, counts.length);
  return below >= 0.6 ? 4 : below >= 0.3 ? 3 : below >= 0.1 ? 2 : 1;
}

function ordinal(n: number) {
  const s = n % 100 >= 11 && n % 100 <= 13 ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[n % 10] ?? 'th';
  return n + s;
}
function tipFor(d: Day) {
  const dt = new Date(d.date + 'T00:00:00Z');
  const when = `${MONTH_LONG[dt.getUTCMonth()]} ${ordinal(dt.getUTCDate())}, ${dt.getUTCFullYear()}`;
  return `${d.count} contribution${d.count === 1 ? '' : 's'} on ${when}.`;
}

const GAP_FILL = '#21262d';
const cellAt = new Map<string, { fill: string; tip: string | null }>();
slots.forEach((s) => cellAt.set(`${s.x},${s.y}`, { fill: GAP_FILL, tip: null }));
let li = 0;
shown.forEach((d, i) => {
  const cell = { fill: LEVELS[levelFor(d.count)], tip: tipFor(d) };
  for (let k = 0; k < runs[i] && li < litSlots.length; k++, li++) cellAt.set(`${litSlots[li].x},${litSlots[li].y}`, cell);
});

const columns = Array.from({ length: cols }, (_, x) => ({
  x: x * STEP,
  cells: Array.from({ length: rows }, (_, y) => ({ y: y * STEP, cell: cellAt.get(`${x},${y}`) })),
}));

const total = shown.reduce((s, d) => s + d.count, 0);
const start = shown.length ? new Date(shown[0].date + 'T00:00:00Z') : new Date();
const since = `${MONTH_LONG[start.getUTCMonth()]} ${start.getUTCFullYear()}`;
---

<div class="contrib" data-contrib>
  <h3 class="contrib__title"><Icon name="sparkle" class="contrib__icon" /><span class="contrib__count" data-count={total}>{total.toLocaleString('en-US')}</span> contributions since {since}</h3>
  <div class="contrib__scroll">
    <svg
      class="contrib__graph"
      viewBox={`0 0 ${width} ${height}`}
      width={width}
      height={height}
      role="img"
      aria-label={`${total} GitHub contributions since ${since}, drawn as the swyr pixel invader`}
    >
      {columns.map((col) => (
        <g>
          {col.cells.map((c) =>
            c.cell
              ? <rect class={c.cell.tip ? undefined : 'contrib__gap'} x={col.x} y={c.y} width={CELL} height={CELL} rx="2" fill={c.cell.fill} data-tip={c.cell.tip ?? undefined} />
              : <rect class="contrib__bg" x={col.x} y={c.y} width={CELL} height={CELL} rx="2" fill={LEVELS[0]} />
          )}
        </g>
      ))}
    </svg>
  </div>
  <div class="contrib__legend" aria-hidden="true">
    <span>Less</span>
    {LEVELS.map((l) => <span class="contrib__swatch" style={`background:${l}`}></span>)}
    <span>More</span>
  </div>
  <div class="contrib__tip" role="tooltip"></div>
</div>
