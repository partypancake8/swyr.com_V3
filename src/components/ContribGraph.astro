---
// GitHub contribution history drawn in the shape of the swyr pixel invader.
// Each filled invader cell is one real day from src/data/contributions.json
// (refreshed by scripts/fetch-contributions.mjs on prebuild), mapped in GitHub
// order: column by column left to right, top to bottom, oldest first, so the
// newest day is the bottom-right-most filled cell. Static SVG built at compile time.
import data from '../data/contributions.json';

// 21 x 20: the 42 x 40 pixel logo downsampled 2x2, with the S hand-fixed
// so each stroke is one cell wide and reads cleanly at this size.
const MATRIX = [
  '....##.........##....',
  '....##.........##....',
  '......##.....##......',
  '......##.....##......',
  '....#############....',
  '....#############....',
  '..#####.......#####..',
  '..#####.#####.#####..',
  '#######.#.....#######',
  '#######.#####.#######',
  '#######.....#.#######',
  '#######.#####.#######',
  '##..###.......###..##',
  '##..#############..##',
  '##..#############..##',
  '##..#############..##',
  '......##.....##......',
  '......##.....##......',
  '....##.........##....',
  '....##.........##....',
];
const LEVELS = ['#161b22', '#0e4429', '#006d32', '#26a641', '#39d353'];
const CELL = 14;
const GAP = 3;
const STEP = CELL + GAP;
const WAVE_MS = 1200;
const MONTH_LONG = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

const cols = MATRIX[0].length;
const rows = MATRIX.length;
const width = cols * STEP - GAP;
const height = rows * STEP - GAP;

// Filled cells in GitHub order (column-major, top to bottom).
const slots: { x: number; y: number }[] = [];
for (let x = 0; x < cols; x++) for (let y = 0; y < rows; y++) if (MATRIX[y][x] === '#') slots.push({ x, y });

type Day = { date: string; count: number; level: number };
const all = ((data as { days?: Day[] }).days ?? []).slice().sort((a, b) => a.date.localeCompare(b.date));
const real = all.slice(-slots.length);
// If history is shorter than the silhouette, the oldest cells are padded at level 0.
const padding = slots.length - real.length;

function ordinal(n: number) {
  const s = n % 100 >= 11 && n % 100 <= 13 ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[n % 10] ?? 'th';
  return n + s;
}
function tipFor(d: Day) {
  const dt = new Date(d.date + 'T00:00:00Z');
  const when = `${MONTH_LONG[dt.getUTCMonth()]} ${ordinal(dt.getUTCDate())}, ${dt.getUTCFullYear()}`;
  return d.count ? `${d.count} contribution${d.count === 1 ? '' : 's'} on ${when}.` : `No contributions on ${when}.`;
}

const filled = new Map<string, { fill: string; tip: string | null }>();
slots.forEach((s, i) => {
  const d = i < padding ? null : real[i - padding];
  filled.set(`${s.x},${s.y}`, d
    ? { fill: LEVELS[Math.max(0, Math.min(4, d.level))], tip: tipFor(d) }
    : { fill: LEVELS[0], tip: null });
});

const columns = Array.from({ length: cols }, (_, x) => ({
  x: x * STEP,
  delay: Math.round((x / (cols - 1)) * WAVE_MS),
  cells: Array.from({ length: rows }, (_, y) => ({ y: y * STEP, cell: filled.get(`${x},${y}`) })),
}));

const total = real.reduce((s, d) => s + d.count, 0);
const start = real.length ? new Date(real[0].date + 'T00:00:00Z') : new Date();
const since = `${MONTH_LONG[start.getUTCMonth()]} ${start.getUTCFullYear()}`;
---

<div class="contrib" data-contrib>
  <h3 class="contrib__title"><span class="contrib__count" data-count={total}>{total.toLocaleString('en-US')}</span> contributions since {since}</h3>
  <div class="contrib__scroll">
    <svg
      class="contrib__graph"
      viewBox={`0 0 ${width} ${height}`}
      width={width}
      height={height}
      role="img"
      aria-label={`${total} GitHub contributions since ${since}, drawn as the swyr pixel invader`}
    >
      {columns.map((col) => (
        <g style={`--d:${col.delay}ms`}>
          {col.cells.map((c) =>
            c.cell
              ? <rect x={col.x} y={c.y} width={CELL} height={CELL} rx="2" fill={c.cell.fill} data-tip={c.cell.tip ?? undefined} />
              : <rect class="contrib__bg" x={col.x} y={c.y} width={CELL} height={CELL} rx="2" fill={LEVELS[0]} />
          )}
        </g>
      ))}
    </svg>
  </div>
  <div class="contrib__legend" aria-hidden="true">
    <span>Less</span>
    {LEVELS.map((l) => <span class="contrib__swatch" style={`background:${l}`}></span>)}
    <span>More</span>
  </div>
  <div class="contrib__tip" role="tooltip"></div>
</div>
