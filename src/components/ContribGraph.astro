---
// GitHub contribution calendar for the last year, from src/data/contributions.json
// (refreshed by scripts/fetch-contributions.mjs on prebuild). Static SVG, built at compile time.
import data from '../data/contributions.json';

const LEVELS = ['#161b22', '#0e4429', '#006d32', '#26a641', '#39d353'];
const CELL = 11;
const GAP = 3;
const STEP = CELL + GAP;
const LEFT = 30;
const TOP = 18;
const WAVE_MS = 1200;
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function ordinal(n: number) {
  const s = n % 100 >= 11 && n % 100 <= 13 ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[n % 10] ?? 'th';
  return n + s;
}
const MONTH_LONG = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

const days = (data.days ?? []) as { date: string; count: number; level: number }[];
const firstDow = days.length ? new Date(days[0].date + 'T00:00:00Z').getUTCDay() : 0;
const weeks: { x: number; delay: number; cells: { y: number; fill: string; tip: string }[] }[] = [];
days.forEach((d, i) => {
  const slot = i + firstDow;
  const col = Math.floor(slot / 7);
  const row = slot % 7;
  if (!weeks[col]) weeks[col] = { x: LEFT + col * STEP, delay: 0, cells: [] };
  const dt = new Date(d.date + 'T00:00:00Z');
  const when = `${MONTH_LONG[dt.getUTCMonth()]} ${ordinal(dt.getUTCDate())}`;
  const tip = d.count ? `${d.count} contribution${d.count === 1 ? '' : 's'} on ${when}.` : `No contributions on ${when}.`;
  weeks[col].cells.push({ y: TOP + row * STEP, fill: LEVELS[Math.max(0, Math.min(4, d.level))], tip });
});
weeks.forEach((w, i) => (w.delay = Math.round((i / Math.max(1, weeks.length - 1)) * WAVE_MS)));

// Month label over the first week whose first day falls in a new month.
const monthLabels: { x: number; text: string }[] = [];
let lastMonth = -1;
weeks.forEach((w, col) => {
  const idx = Math.max(0, col * 7 - firstDow);
  const m = new Date(days[idx].date + 'T00:00:00Z').getUTCMonth();
  if (m !== lastMonth) {
    const prev = monthLabels[monthLabels.length - 1];
    if (!prev || w.x - prev.x >= STEP * 3) monthLabels.push({ x: w.x, text: MONTHS[m] });
    else prev.text = MONTHS[m];
    lastMonth = m;
  }
});
if (monthLabels.length > 1 && monthLabels[1].x - monthLabels[0].x < STEP * 3) monthLabels.shift();

const width = LEFT + weeks.length * STEP - GAP;
const height = TOP + 7 * STEP - GAP;
const total = data.total ?? days.reduce((s, d) => s + d.count, 0);
---

<div class="contrib" data-contrib>
  <h3 class="contrib__title">{total.toLocaleString('en-US')} contributions in the last year</h3>
  <div class="contrib__scroll">
    <svg
      class="contrib__graph"
      viewBox={`0 0 ${width} ${height}`}
      width={width}
      height={height}
      role="img"
      aria-label={`${total} GitHub contributions in the last year`}
    >
      {monthLabels.map((m) => <text class="contrib__label" x={m.x} y="10">{m.text}</text>)}
      <text class="contrib__label" x="0" y={TOP + 1 * STEP + 9}>Mon</text>
      <text class="contrib__label" x="0" y={TOP + 3 * STEP + 9}>Wed</text>
      <text class="contrib__label" x="0" y={TOP + 5 * STEP + 9}>Fri</text>
      {weeks.map((w) => (
        <g style={`--d:${w.delay}ms`}>
          {w.cells.map((c) => <rect x={w.x} y={c.y} width={CELL} height={CELL} rx="2" fill={c.fill} data-tip={c.tip} />)}
        </g>
      ))}
    </svg>
  </div>
  <div class="contrib__legend" aria-hidden="true">
    <span>Less</span>
    {LEVELS.map((l) => <span class="contrib__swatch" style={`background:${l}`}></span>)}
    <span>More</span>
  </div>
  <div class="contrib__tip" role="tooltip" hidden></div>
</div>
