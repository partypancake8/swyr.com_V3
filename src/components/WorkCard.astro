---
// GitHub-repo-style project card. The title link is stretched over the whole
// card; secondary links (repo) sit above that overlay so they stay clickable.
import repoData from '../data/repos.json';

interface Props {
  title: string;
  href: string;
  desc: string;
  tags: string[];
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** GitHub repo name under partypancake8, for the language / stars footer. */
  repo?: string;
  /** Show a secondary "repo ↗" link (used when the card itself links elsewhere). */
  repoLink?: boolean;
  external?: boolean;
  /** Show the repo icon and "Public" pill in the header (repo-style card). */
  pill?: boolean;
  /** Show the thumbnail whole, centered on a dark panel (for UI screenshots). */
  imageFit?: boolean;
}
const { title, href, desc, tags, image, imageAlt = '', imageWidth = 800, imageHeight = 600, repo, repoLink = false, external = false, pill = false, imageFit = false } = Astro.props;

const LANG_COLORS: Record<string, string> = {
  Swift: '#F05138', 'C++': '#f34b7d', C: '#555555', Shell: '#89e051', Python: '#3572A5',
  TypeScript: '#3178c6', JavaScript: '#f1e05a', Astro: '#ff5a03', Rust: '#dea584', Go: '#00ADD8',
};
const meta = repo ? (repoData as { repos: Record<string, { url: string; language: string | null; stars: number; visibility: string }> }).repos[repo] : undefined;
const linkAttrs = external ? { target: '_blank', rel: 'noopener' } : {};
---

<article class:list={['work-card', { 'work-card--thumb': image, 'work-card--repo': pill }]}>
  {image && (
    <div class:list={['work-card__thumb', { 'work-card__thumb--fit': imageFit }]}>
      <img src={image} alt={imageAlt} width={imageWidth} height={imageHeight} loading="lazy" />
    </div>
  )}
  <div class="work-card__body">
    <div class="work-card__header">
      {pill && (
        <svg class="work-card__repo-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path fill="currentColor" d="M3 2.5A1.5 1.5 0 0 1 4.5 1h8.25a.75.75 0 0 1 .75.75v10.5a.75.75 0 0 1-.75.75H11v-1.5h1V2.5H4.5a.5.5 0 0 0-.5.5v7.05c.16-.03.33-.05.5-.05H9V11.5H4.5a.5.5 0 0 0 0 1H6V14H4.5A2 2 0 0 1 2.5 12V3A1.5 1.5 0 0 1 3 2.5Zm4 9.5h3v3.25a.25.25 0 0 1-.4.2L8.8 14.8a.5.5 0 0 0-.6 0l-.8.65a.25.25 0 0 1-.4-.2Z" />
        </svg>
      )}
      <a class="work-card__title work-card__link" href={href} {...linkAttrs}>{title}</a>
      {pill && <span class="work-card__pill">Public</span>}
      {!pill && <span class="work-card__arrow" aria-hidden="true">view &rarr;</span>}
    </div>
    <p class="work-card__desc">{desc}</p>
    <ul class="work-card__tags">
      {tags.map((tag, i) => <li class="work-card__tag" style={`--i:${i}`}>{tag}</li>)}
    </ul>
    {(meta || repoLink) && (
      <div class="work-card__footer">
        {meta?.language && (
          <span class="work-card__lang">
            <span class="work-card__lang-dot" style={`background:${LANG_COLORS[meta.language] ?? '#8b949e'}`}></span>
            {meta.language}
          </span>
        )}
        {meta && (
          <span class="work-card__stars" aria-label={`${meta.stars} stars`}>
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 .25a.75.75 0 0 1 .67.42l1.88 3.8 4.2.61a.75.75 0 0 1 .41 1.28l-3.04 2.96.72 4.18a.75.75 0 0 1-1.09.79L8 12.31l-3.75 1.98a.75.75 0 0 1-1.09-.79l.72-4.18L.84 6.36a.75.75 0 0 1 .41-1.28l4.2-.61L7.33.67A.75.75 0 0 1 8 .25Zm0 2.45L6.62 5.5a.75.75 0 0 1-.57.41l-3.08.45 2.23 2.17a.75.75 0 0 1 .22.66l-.53 3.07 2.76-1.45a.75.75 0 0 1 .7 0l2.76 1.45-.53-3.07a.75.75 0 0 1 .22-.66l2.23-2.17-3.08-.45a.75.75 0 0 1-.57-.41Z" /></svg>
            {meta.stars}
          </span>
        )}
        {repoLink && repo && (
          <a class="work-card__repo-link" href={meta?.url ?? `https://github.com/partypancake8/${repo}`} target="_blank" rel="noopener">repo&nbsp;&#8599;</a>
        )}
      </div>
    )}
  </div>
</article>
