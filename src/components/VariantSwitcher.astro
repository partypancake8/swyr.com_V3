---
// Temporary design-comparison switcher. Delete this component, its import in
// BaseLayout, the head script there, and the unused variant theme files to
// settle on one look.
---

<div class="variant-switcher" role="group" aria-label="Design variant" transition:persist="variant-switcher">
  <span class="variant-switcher__label">Variant</span>
  <button type="button" data-set-variant="a" title="GitHub light">A</button>
  <button type="button" data-set-variant="b" title="GitHub dark">B</button>
  <button type="button" data-set-variant="c" title="Profile layout (follows system theme)">C</button>
</div>

<script is:inline>
  (function () {
    function sync() {
      var cur = document.documentElement.dataset.variant;
      document.querySelectorAll('[data-set-variant]').forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.dataset.setVariant === cur));
      });
    }
    if (!window.__swyrSwitcher) {
      window.__swyrSwitcher = true;
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('[data-set-variant]');
        if (!b) return;
        var v = b.dataset.setVariant;
        document.documentElement.dataset.variant = v;
        try { localStorage.setItem('swyr-variant', v); } catch (err) {}
        try {
          var u = new URL(location.href);
          u.searchParams.set('variant', v);
          history.replaceState(history.state, '', u);
        } catch (err) {}
        sync();
      });
      document.addEventListener('astro:after-swap', sync);
    }
    sync();
  })();
</script>
