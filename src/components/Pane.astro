---
import { Picture } from 'astro:assets';
import portrait from '../assets/sawyer.png';

const nav = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'skills', label: 'Skills' },
  { id: 'work', label: 'Work' },
  { id: 'contact', label: 'Contact' },
];
---

<aside class="pane">
  <div class="pane__top">
    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      widths={[160, 240, 320, 480]}
      sizes="160px"
      alt="Sawyer Smith"
      loading="eager"
      fetchpriority="high"
      class="pane__photo"
    />
    <h1 class="pane__name">Sawyer&nbsp;Smith</h1>
    <p class="pane__role">Robotics Engineer · Full-Stack Developer</p>
    <p class="pane__bio">
      I build interactive systems that blend real-time software, robotics, and
      clean user experiences, taking ideas from concept to launch.
    </p>
    <p class="pane__status"><span class="pane__dot" aria-hidden="true"></span> Currently building at Decypher</p>
  </div>

  <nav class="pane__nav" aria-label="Section navigation">
    <ul role="list">
      {nav.map((item, i) => (
        <li>
          <a href={`#${item.id}`} data-spy={item.id}>
            <span class="pane__nav-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="pane__nav-label">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="pane__foot">
    <a class="pane__resume" href="/documents/Sawyer Smith Resume 2025.pdf" target="_blank" rel="noopener">
      Résumé <span aria-hidden="true">↗</span>
    </a>
    <ul class="pane__social" role="list">
      <li>
        <a href="https://github.com/partypancake8/" target="_blank" rel="noopener" aria-label="GitHub">
          <img src="/icons/github.svg" alt="" width="20" height="20" />
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/in/sawyer-smith-60918a221/" target="_blank" rel="noopener" aria-label="LinkedIn">
          <img src="/icons/linkedin.svg" alt="" width="20" height="20" />
        </a>
      </li>
      <li>
        <a href="mailto:swyr@swyr.com" aria-label="Email Sawyer">
          <img src="/icons/emailicon.svg" alt="" width="20" height="20" />
        </a>
      </li>
    </ul>
  </div>
</aside>

<style>
  .pane {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--pane-w);
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: var(--space-xl) var(--space-lg);
    border-right: 1px solid var(--border);
    background:
      radial-gradient(120% 60% at 0% 0%, var(--accent-soft), transparent 60%),
      var(--surface);
  }

  .pane__photo {
    width: 84px;
    height: 84px;
    border-radius: var(--radius);
    object-fit: cover;
    object-position: center 20%;
    border: 1px solid var(--accent-line);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .pane__name {
    font-size: var(--step-3);
    letter-spacing: -0.02em;
    margin-top: var(--space-md);
  }

  .pane__role {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
    margin-top: var(--space-2xs);
  }

  .pane__bio {
    color: var(--text-dim);
    font-size: var(--step-0);
    max-width: 32ch;
    margin-top: var(--space-sm);
  }

  .pane__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
    margin-top: var(--space-md);
  }

  .pane__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent-glow);
    animation: pulse 2.4s var(--ease) infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 var(--accent-glow); }
    70% { box-shadow: 0 0 0 7px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  /* ── Scroll-spy nav ── */
  .pane__nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .pane__nav a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2xs);
    width: fit-content;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: var(--step-0);
    transition: color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .pane__nav-index {
    font-size: var(--step--1);
    color: var(--accent-dim);
    transition: color var(--dur) var(--ease);
  }

  .pane__nav a:hover,
  .pane__nav a:focus-visible {
    color: var(--text);
    transform: translateX(4px);
  }

  .pane__nav a.is-active {
    color: var(--accent);
    transform: translateX(4px);
  }

  .pane__nav a.is-active .pane__nav-index {
    color: var(--accent);
  }

  /* ── Footer of pane ── */
  .pane__foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .pane__resume {
    align-self: flex-start;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-sm);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .pane__resume:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .pane__social {
    display: flex;
    gap: var(--space-md);
  }

  .pane__social a {
    opacity: 0.7;
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .pane__social a:hover,
  .pane__social a:focus-visible {
    opacity: 1;
    transform: translateY(-2px);
  }

  /* ── Stacked layout ── */
  @media (max-width: 1024px) {
    .pane {
      position: static;
      width: 100%;
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--border);
      padding: var(--space-xl) var(--space-md) var(--space-lg);
      gap: var(--space-lg);
    }

    .pane__nav ul {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-xs) var(--space-md);
    }

    .pane__foot {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
