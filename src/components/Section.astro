---
interface Props {
  id: string;
  index: string;
  title: string;
}
const { id, index, title } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-heading`}>
  <header class="section__head">
    <span class="section__index" aria-hidden="true">{index}</span>
    <h2 id={`${id}-heading`} class="section__title">{title}</h2>
    <span class="section__rule" aria-hidden="true"></span>
  </header>
  <div class="section__body">
    <slot />
  </div>
</section>

<style>
  .section {
    scroll-margin-top: var(--space-xl);
  }

  .section__head {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .section__index {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
  }

  .section__title {
    font-size: var(--step-2);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .section__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border-strong), transparent);
  }

  .section__body {
    color: var(--text-dim);
    max-width: var(--content-max);
  }
</style>
