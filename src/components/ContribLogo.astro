---
// The pixel invader logo drawn as a GitHub contribution graph.
// 42 x 40 cells, 10px squares with 3px gaps, rendered to static SVG at build time.
const MATRIX = [
  '........####..................####........',
  '........####..................####........',
  '........####..................####........',
  '........####..................####........',
  '............####..........####............',
  '............####..........####............',
  '............####..........####............',
  '............####..........####............',
  '........##########################........',
  '........##########################........',
  '........##########################........',
  '........##########################........',
  '....###########............###########....',
  '....###########............###########....',
  '....#########................#########....',
  '....#########....########....#########....',
  '#############....########....#############',
  '#############....#########################',
  '#############....#########################',
  '#############..............###############',
  '###############............###############',
  '###############..............#############',
  '#########################....#############',
  '#########################....#############',
  '####....#####....########....#####....####',
  '####....#####....########....#####....####',
  '####....#####................#####....####',
  '####....#######............#######....####',
  '####....#######............#######....####',
  '####....##########################....####',
  '####....##########################....####',
  '####....##########################....####',
  '............####..........####............',
  '............####..........####............',
  '............####..........####............',
  '............####..........####............',
  '........####..................####........',
  '........####..................####........',
  '........####..................####........',
  '........####..................####........',
];
const LEVELS = ['#161b22', '#0e4429', '#006d32', '#26a641', '#39d353'];
const CELL = 10;
const GAP = 3;
const STEP = CELL + GAP;
const cols = MATRIX[0].length;
const rows = MATRIX.length;
const width = cols * STEP - GAP;
const height = rows * STEP - GAP;

// Deterministic per-cell noise so the shading looks like real activity
// but is identical on every build.
function noise(x: number, y: number) {
  let h = (x * 374761393 + y * 668265263) ^ 0x5bd1e995;
  h = Math.imul(h ^ (h >>> 13), 1274126177);
  return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
}
function level(filled: boolean, x: number, y: number) {
  const n = noise(x, y);
  if (!filled) return n < 0.08 ? 1 : 0;
  if (n < 0.12) return 2;
  if (n < 0.45) return 3;
  return 4;
}
const cells: { x: number; y: number; fill: string }[] = [];
for (let y = 0; y < rows; y++) {
  for (let x = 0; x < cols; x++) {
    cells.push({ x: x * STEP, y: y * STEP, fill: LEVELS[level(MATRIX[y][x] === '#', x, y)] });
  }
}
---

<div class="contrib">
  <svg
    class="contrib__graph"
    viewBox={`0 0 ${width} ${height}`}
    width={width}
    height={height}
    role="img"
    aria-label="The swyr pixel invader logo drawn as a contribution graph"
  >
    {cells.map((c) => <rect x={c.x} y={c.y} width={CELL} height={CELL} rx="2" fill={c.fill} />)}
  </svg>
  <div class="contrib__legend" aria-hidden="true">
    <span>Less</span>
    {LEVELS.map((l) => <span class="contrib__swatch" style={`background:${l}`}></span>)}
    <span>More</span>
  </div>
</div>
