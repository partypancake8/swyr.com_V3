---
// Resume: the PDF's pages shown inline as images (works in every browser, incl. Safari / iOS),
// plus download / open buttons. The images are pre-rendered and committed: after replacing
// public/documents/sawyer-smith-resume.pdf, run `npm run resume:render` locally and commit
// public/documents/resume-pages/ (Netlify's build image has no PDF renderer).
import { readFileSync, statSync } from 'node:fs';
import { join } from 'node:path';
import ProjectLayout from '../layouts/ProjectLayout.astro';
import Icon from '../components/Icon.astro';

const PDF = '/documents/sawyer-smith-resume.pdf';
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
let updated = '';
try {
  const m = statSync(join(process.cwd(), 'public/documents/sawyer-smith-resume.pdf')).mtime;
  updated = `${MONTHS[m.getMonth()]} ${m.getFullYear()}`;
} catch {}
let pages: { src: string; width: number; height: number }[] = [];
try {
  pages = JSON.parse(readFileSync(join(process.cwd(), 'public/documents/resume-pages/manifest.json'), 'utf8')).pages;
} catch {}
---

<ProjectLayout title="Resume · Sawyer Smith">
  <header class="resume-head">
    <div class="resume-head__text">
      <h1 class="resume-head__title"><Icon name="file" size={24} class="resume-head__icon" />Resume</h1>
      <p class="resume-head__meta">{updated ? `PDF · updated ${updated}` : 'PDF'}</p>
    </div>
    <div class="resume-head__actions">
      <a class="outline-btn resume-btn resume-btn--primary" href={PDF} download="Sawyer Smith Resume.pdf">
        <Icon name="download" />
        Download PDF
      </a>
      <a class="outline-btn resume-btn" href={PDF} target="_blank" rel="noopener"><Icon name="external" />Open in new tab</a>
    </div>
  </header>

  <section class="resume-panel" aria-label="Resume preview">
    {pages.map((pg, i) => (
      <img
        class="resume-page"
        src={pg.src}
        width={pg.width}
        height={pg.height}
        alt={`Resume page ${i + 1}`}
        loading={i === 0 ? 'eager' : 'lazy'}
        decoding="async"
      />
    ))}
    {pages.length === 0 && (
      <div class="resume-panel__fallback">
        <a class="outline-btn resume-btn resume-btn--primary" href={PDF} download="Sawyer Smith Resume.pdf"><Icon name="download" />Download PDF</a>
      </div>
    )}
  </section>
</ProjectLayout>
