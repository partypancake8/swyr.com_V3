        </div>
        <div class="jrow">
          <ul class="jrow__half">
            <li class="proj-stage__item" style="--a: 0.75">
              <figure>
                <div class="proj-stage__frame">
                  <img src="/images/4square/proto-oled-pcbs.jpg" alt="Four OLED carrier boards and the ESP32 before wiring" width="768" height="1024" loading="lazy" />
                </div>
              </figure>
            </li>
            <li class="proj-stage__item" style="--a: 0.75">
              <figure>
                <div class="proj-stage__frame">
                  <img src="/images/4square/proto-boards.jpg" alt="Two protoboards wired together, held over the desk" width="768" height="1024" loading="lazy" />
                </div>
              </figure>
            </li>
          </ul>
          <ul class="jrow__half">
            <li class="proj-stage__item" style="--a: 0.75">
              <figure>
                <div class="proj-stage__frame">
                  <img src="/images/4square/proto-wired.jpg" alt="First enclosure face with the four OLEDs showing test patterns" width="768" height="1024" loading="lazy" />
                </div>
              </figure>
            </li>
            <li class="proj-stage__item" style="--a: 0.75">
              <figure>
                <div class="proj-stage__frame">
                  <img src="/images/4square/prototype.jpeg" alt="Prototype wiring: protoboard mux breakout with four OLEDs on jumper wires" width="768" height="1024" loading="lazy" />
                </div>
              <figcaption class="proj-stage__cap">protoboard I&sup2;C mux breakout &middot; 4&times; OLEDs on jumper wires &middot; testing before the enclosure</figcaption>
              </figure>
            </li>
          </ul>
        </div>
      </li>
      <li class="proj-stage">
        <div class="proj-stage__head">
          <span class="proj-stage__dot" aria-hidden="true"></span>
          <p class="proj-stage__label">V0</p>
          <p class="proj-stage__note">the original build, hand-wired in a 3D-printed enclosure</p>
        </div>
        <div class="jrow">
          <ul class="jrow__half">
            <li class="proj-stage__item" style="--a: 0.75">
              <figure>
                <div class="proj-stage__frame">
                  <img src="/images/4square/finished.jpeg" alt="4square V0, the original 3D-printed build, finished" width="768" height="1024" loading="lazy" />
                </div>
              </figure>
            </li>
            <li class="proj-stage__item" style="--a: 1.77778">
              <figure>
                <div class="proj-stage__frame">
                  <video
                    autoplay
                    loop
                    muted
                    playsinline
                    disablepictureinpicture
                    preload="metadata"
                    width="1920"
                    height="1080"
                    poster="/images/4square/finished.jpeg"
                    src="/images/4square/enclosure.mp4"
                  ></video>
                </div>
              <figcaption class="proj-stage__cap">V0 enclosure &middot; display faceplate &middot; display mounts &middot; back panel &middot; lid</figcaption>
              </figure>
            </li>
