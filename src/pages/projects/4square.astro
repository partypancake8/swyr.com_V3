---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import Icon from '../../components/Icon.astro';
---

<ProjectLayout title="4square · build log" breadcrumb="4square">
  <!-- ── hero ─────────────────────────── -->
  <header class="proj-hero">
    <p class="proj-eyebrow">project build log</p>
    <h1 class="proj-title">4square</h1>
    <p class="proj-tagline">A four-screen desk clock on a custom PCB, in a printed case with a clear acrylic back.</p>
    <ul class="proj-tags">
      <li class="proj-tag">embedded</li>
      <li class="proj-tag">custom PCB</li>
      <li class="proj-tag">code CAD</li>
      <li class="proj-tag">ESP32-C3</li>
      <li class="proj-tag">open source</li>
    </ul>
    <p class="proj-hero-actions">
      <a class="outline-btn" href="https://github.com/partypancake8/4square_production" target="_blank" rel="noopener"><Icon name="github" size={16} />View on GitHub</a>
    </p>
    <div class="proj-meta">
      <div class="proj-meta-item">
        <span class="proj-meta-label">Type</span>
        <span class="proj-meta-value">desk gadget</span>
      </div>
      <div class="proj-meta-item">
        <span class="proj-meta-label">Date</span>
        <span class="proj-meta-value">2026</span>
      </div>
      <div class="proj-meta-item">
        <span class="proj-meta-label">Status</span>
        <span class="proj-meta-value proj-meta-value--green">complete, iterating</span>
      </div>
      <div class="proj-meta-item">
        <span class="proj-meta-label">Source</span>
        <a
          class="proj-meta-link"
          href="https://github.com/partypancake8/4square_production"
          target="_blank"
          rel="noopener"
        ><Icon name="github" size={12} />4square_production</a>
      </div>
    </div>
  </header>

  <!-- ── hero image ───────────────────── -->
  <div class="proj-hero-media">
    <img
      class="proj-hero-img"
      src="/images/4square/v1-early-front.jpg"
      width="1600"
      height="1200"
      alt="Finished 4square build on a desk"
    />
  </div>
  <p class="proj-media-caption">
    V1 &middot; custom PCB &middot; 4&times; SSD1306 OLEDs &middot; printed shell
  </p>

  <!-- ── exploded animation ───────────── -->
  <div class="proj-gallery--row proj-hero-anim">
    <figure class="proj-gallery__item" style="flex: 1">
      <video
        autoplay
        loop
        muted
        playsinline
        disablepictureinpicture
        preload="auto"
        width="888"
        height="680"
        poster="/images/4square/4square-exploded-still.webp"
        src="/videos/4square-exploded.mp4"
      >
        <img src="/images/4square/4square-exploded.gif" alt="Animated exploded view of the 4square case" width="888" height="680" />
      </video>
      <figcaption class="proj-stage__cap">exploded view &middot; screws, acrylic back, standoff frame, PCB, retainer, screens, shell</figcaption>
    </figure>
  </div>

  <!-- ── overview ─────────────────────── -->
  <section class="proj-section" id="overview" data-crumb="overview">
    <p class="proj-section-label">overview</p>
    <div class="proj-overview-split">
      <div class="proj-overview-text">
        <h2 class="proj-section-heading">what is this?</h2>
        <p>
          4square is a small desk clock: four 128&times;64 OLED panels in a 2&times;2 grid,
          hours top left, minutes top right, weekday and date along the bottom. It started as
          four screen modules on jumper wires and a protoboard, and it is now a 74&times;74 mm
          board I designed in KiCad, inside a case I wrote in code with build123d, with a
          laser-cut acrylic back so you can see the board. Behind the screens there is a
          real-time clock, a temperature and humidity sensor, a light sensor for auto-dimming,
          three RGB status LEDs, four buttons and an EEPROM that keeps the settings.
        </p>
        <p>
          OLEDs burn in when the same pixels stay lit, and a clock lights the same digits for months,
          so the firmware is written around panel lifetime. Every pixel goes through one function that
          shifts the image and caps the brightness, and a layout prover on my laptop checks every
          screen before the flash script will flash the board.
        </p>
      </div>
      <aside class="proj-specs">
        <div class="proj-spec-row">
          <span class="proj-spec-label">MCU</span>
          <span class="proj-spec-value">ESP32-C3 SuperMini</span>
        </div>
        <div class="proj-spec-row">
          <span class="proj-spec-label">Displays</span>
          <span class="proj-spec-value">4&times; 0.96 in SSD1306 128&times;64 OLED</span>
        </div>
        <div class="proj-spec-row">
          <span class="proj-spec-label">Clock</span>
          <span class="proj-spec-value">DS3231 RTC</span>
        </div>
        <div class="proj-spec-row">
          <span class="proj-spec-label">Sensors</span>
          <span class="proj-spec-value">SHT31 temp / humidity, light sensor</span>
        </div>
        <div class="proj-spec-row">
          <span class="proj-spec-label">Memory</span>
          <span class="proj-spec-value">24LC256 EEPROM</span>
        </div>
        <div class="proj-spec-row">
          <span class="proj-spec-label">Board</span>
          <span class="proj-spec-value">custom 74&times;74 mm, 2-layer, KiCad, rev N</span>
        </div>
        <div class="proj-spec-row">
          <span class="proj-spec-label">Case</span>
          <span class="proj-spec-value">rev 5 PETG prints + rev 6 laser-cut acrylic back</span>
        </div>
        <div class="proj-spec-row">
          <span class="proj-spec-label">Power</span>
          <span class="proj-spec-value">USB-C</span>
        </div>
      </aside>
    </div>
  </section>

  <hr class="proj-divider" />

  <!-- ── build stages: prototype, V0, V1 ── -->
  <section class="proj-section" id="build" data-crumb="build">
    <p class="proj-section-label"><Icon name="camera" class="proj-section-label__icon" />build stages</p>
