---
// GitHub-repo-style project pages rendered from each repo's README.
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import repoData from '../../data/repos.json';
import { renderReadme } from '../../lib/readme';
import Icon from '../../components/Icon.astro';

const readmes = import.meta.glob('../../data/readmes/*.md', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

const PROJECTS = [
  { slug: 'mdlive', repo: 'MDLive', title: 'MDLive', tags: ['macOS', 'Swift', 'Linux', 'GTK'] },
  { slug: 'supercaffeinate', repo: 'supercaffeinate', title: 'SuperCaffeinate', tags: ['macOS', 'Swift', 'menu bar', 'CLI'] },
];

export function getStaticPaths() {
  return [{ params: { slug: 'mdlive' } }, { params: { slug: 'supercaffeinate' } }];
}

const { slug } = Astro.params;
const project = PROJECTS.find((p) => p.slug === slug)!;
type Meta = { url: string; description: string; language: string | null; stars: number; defaultBranch?: string; topics?: string[] };
const meta = (repoData as { repos: Record<string, Meta> }).repos[project.repo];
const branch = meta?.defaultBranch ?? 'main';
const repoUrl = meta?.url ?? `https://github.com/partypancake8/${project.repo}`;
const md = readmes[`../../data/readmes/${project.repo}.md`] ?? '';
const html = md ? renderReadme(md, project.repo, branch) : '';
const topics = meta?.topics?.length ? meta.topics : project.tags;
const LANG_COLORS: Record<string, string> = { Swift: '#F05138', 'C++': '#f34b7d', Shell: '#89e051', Python: '#3572A5', C: '#555555' };
---

<ProjectLayout title={`${project.title} · partypancake8`}>
  <header class="repo-head">
    <div class="repo-head__title">
      <Icon name="folder" size={20} class="repo-head__icon" />
      <h1 class="repo-head__name">
        <a href="https://github.com/partypancake8" target="_blank" rel="noopener">partypancake8</a>
        <span class="repo-head__sep">/</span>
        <a class="repo-head__repo" href={repoUrl} target="_blank" rel="noopener">{project.repo}</a>
      </h1>
      <span class="work-card__pill">Public</span>
    </div>
    {meta?.description && <p class="repo-head__desc">{meta.description}</p>}
    <div class="repo-head__meta">
      {meta?.language && (
        <span class="work-card__lang">
          <span class="work-card__lang-dot" style={`background:${LANG_COLORS[meta.language] ?? '#8b949e'}`}></span>
          {meta.language}
        </span>
      )}
      {meta && (
        <span class="work-card__stars">
          <Icon name="px-star" class="work-card__star" />
          {meta.stars} {meta.stars === 1 ? 'star' : 'stars'}
        </span>
      )}
      <span class="repo-head__branch"><Icon name="git-branch" />{branch}</span>
      <ul class="repo-head__topics">
        {topics.map((t) => <li class="work-card__tag"><Icon name="tag" size={12} class="work-card__tag-icon" />{t}</li>)}
      </ul>
      <a class="outline-btn repo-head__btn" href={repoUrl} target="_blank" rel="noopener"><Icon name="github" />View on GitHub</a>
    </div>
  </header>

  <section class="readme-panel" aria-label="README">
    <div class="readme-panel__bar">
      <Icon name="book" />
      README.md
    </div>
    <article class="markdown-body" set:html={html} />
  </section>
</ProjectLayout>
