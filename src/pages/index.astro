---
import LandingLayout from '../layouts/LandingLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import ContribGraph from '../components/ContribGraph.astro';
import Icon from '../components/Icon.astro';

const photos = [
  { src: '/images/carousel/sawyerinvad.jpeg', alt: 'Sawyer next to a pixel invader mural' },
  { src: '/images/carousel/sawyersam.jpeg', alt: 'Sawyer on a boat' },
  { src: '/images/carousel/sawyerbray.jpeg', alt: 'Sawyer and a friend by the lake' },
  { src: '/images/carousel/sawyerjoe.jpeg', alt: 'Sawyer and a friend in sunglasses' },
  { src: '/images/carousel/3boy.jpeg', alt: 'Sawyer with two friends' },
  { src: '/images/carousel/lildog.jpeg', alt: 'Sawyer with a small dog' },
];
---

<LandingLayout description="Robotics engineering student at the University of Michigan building embedded hardware, real-time software, and the interfaces around them.">
  <section class="hero">
    <div class="hero__tilt">
      <svg class="hero__logo" width="220" height="220" viewBox="0 -1 42 42" role="img" aria-label="The swyr pixel invader">
        <defs>
          <symbol id="swyr-invader" viewBox="0 -1 42 42">
            <path fill="currentColor" shape-rendering="crispEdges" d="M8 0h4v1h-4zM30 0h4v1h-4zM8 1h4v1h-4zM30 1h4v1h-4zM8 2h4v1h-4zM30 2h4v1h-4zM8 3h4v1h-4zM30 3h4v1h-4zM12 4h4v1h-4zM26 4h4v1h-4zM12 5h4v1h-4zM26 5h4v1h-4zM12 6h4v1h-4zM26 6h4v1h-4zM12 7h4v1h-4zM26 7h4v1h-4zM8 8h26v1h-26zM8 9h26v1h-26zM8 10h26v1h-26zM8 11h26v1h-26zM4 12h11v1h-11zM27 12h11v1h-11zM4 13h11v1h-11zM27 13h11v1h-11zM4 14h9v1h-9zM29 14h9v1h-9zM4 15h9v1h-9zM17 15h8v1h-8zM29 15h9v1h-9zM0 16h13v1h-13zM17 16h8v1h-8zM29 16h13v1h-13zM0 17h13v1h-13zM17 17h25v1h-25zM0 18h13v1h-13zM17 18h25v1h-25zM0 19h13v1h-13zM27 19h15v1h-15zM0 20h15v1h-15zM27 20h15v1h-15zM0 21h15v1h-15zM29 21h13v1h-13zM0 22h25v1h-25zM29 22h13v1h-13zM0 23h25v1h-25zM29 23h13v1h-13zM0 24h4v1h-4zM8 24h5v1h-5zM17 24h8v1h-8zM29 24h5v1h-5zM38 24h4v1h-4zM0 25h4v1h-4zM8 25h5v1h-5zM17 25h8v1h-8zM29 25h5v1h-5zM38 25h4v1h-4zM0 26h4v1h-4zM8 26h5v1h-5zM29 26h5v1h-5zM38 26h4v1h-4zM0 27h4v1h-4zM8 27h7v1h-7zM27 27h7v1h-7zM38 27h4v1h-4zM0 28h4v1h-4zM8 28h7v1h-7zM27 28h7v1h-7zM38 28h4v1h-4zM0 29h4v1h-4zM8 29h26v1h-26zM38 29h4v1h-4zM0 30h4v1h-4zM8 30h26v1h-26zM38 30h4v1h-4zM0 31h4v1h-4zM8 31h26v1h-26zM38 31h4v1h-4zM12 32h4v1h-4zM26 32h4v1h-4zM12 33h4v1h-4zM26 33h4v1h-4zM12 34h4v1h-4zM26 34h4v1h-4zM12 35h4v1h-4zM26 35h4v1h-4zM8 36h4v1h-4zM30 36h4v1h-4zM8 37h4v1h-4zM30 37h4v1h-4zM8 38h4v1h-4zM30 38h4v1h-4zM8 39h4v1h-4zM30 39h4v1h-4z" />
          </symbol>
        </defs>
        <use href="#swyr-invader" />
      </svg>
    </div>
    <div class="hero__text">
    <div class="hero__eyebrow">Hi, my name is</div>
    <h1 class="hero__title">
      <span class="hero__headline">Sawyer Smith.</span>
      <span class="hero__subtitle">I like to make things!</span>
    </h1>
    <a class="outline-btn" href="#work">See my work</a>
    <div class="contact-links hero__links">
      <a class="outline-btn" href="https://github.com/partypancake8/" target="_blank" rel="noopener">
        <Icon name="github" class="icon-svg" /> GitHub
      </a>
      <a class="outline-btn" href="https://www.linkedin.com/in/sawyer-smith-60918a221/" target="_blank" rel="noopener">
        <Icon name="linkedin" class="icon-svg" /> LinkedIn
      </a>
      <a class="outline-btn" href="mailto:swyr@swyr.com">
        <Icon name="mail" class="icon-svg" /> swyr@swyr.com
      </a>
    </div>
    </div>
  </section>

  <section id="work" class="section-block" data-crumb="work">
    <h2 class="section-heading">
      <Icon name="px-chip" size={20} class="section-heading__icon" /><span class="nav-index">01.</span> <span class="section-title">Work</span>
    </h2>
    <p class="section-lede">
      Personal projects and engineering work: embedded hardware, robotics, and software tools.
    </p>
    <div class="work-cards">
      <WorkCard
        title="4 square"
        href="/projects/4square"
        desc="Four 128×64 OLEDs, each independently programmable. Feather ESP32-S3 with WiFi, NTP, battery gauge, and a 3D-printed enclosure."
        tags={["embedded", "ESP32-S3", "3D printed", "open source"]}
        image="/images/4square/v1-early-front.jpg"
        imageWidth={1600}
        imageHeight={1200}
        imageAlt="4 square desk display"
        repo="4square_production"
        repoLink
      />
      <WorkCard
        title="MDLive"
        href="/projects/mdlive"
        desc="A Markdown previewer that re-renders the moment the file changes on disk. Native macOS app (Swift, WKWebView) plus a Linux port (GTK3, WebKit2GTK) sharing the same renderer."
        tags={["macOS", "Swift", "Linux", "GTK"]}
        image="https://raw.githubusercontent.com/partypancake8/MDLive/main/docs/images/thumb-dark.png"
        imageAlt="MDLive dark theme reading view"
        imageWidth={880}
        imageHeight={560}
        imageFit
        repo="MDLive"
        repoLink
        pill
      />
      <WorkCard
        title="SuperCaffeinate"
        href="/projects/supercaffeinate"
        desc="Keep a Mac fully awake from the terminal or a menu bar item: no sleep, no display sleep, no screensaver, no auto-lock, with sensible lid and external display handling."
        tags={["macOS", "Swift", "menu bar", "CLI"]}
        image="https://raw.githubusercontent.com/partypancake8/supercaffeinate/main/docs/menubar-menu.png"
        imageAlt="SuperCaffeinate menu bar menu"
        imageWidth={323}
        imageHeight={158}
        imageFit
        repo="supercaffeinate"
        repoLink
        pill
      />
    </div>
  </section>

  <section id="experience" class="section-block" data-crumb="experience">
    <h2 class="section-heading">
      <Icon name="px-briefcase" size={20} class="section-heading__icon" /><span class="nav-index">02.</span> <span class="section-title">Experience</span>
    </h2>
    <div class="timeline-wrap">
    <div class="tl-indicator" aria-hidden="true">
      <span class="tl-indicator__line"></span>
      <span class="tl-indicator__dot"></span>
    </div>
    <ol class="timeline">
      <li class="tl-item">
        <div class="tl-item__head">
          <span class="tl-item__org"><Icon name="px-grad-cap" class="tl-item__icon" /><span class="tl-item__name">University of Michigan School of Information</span><span class="org-tile"><img src="/icons/companies/umsi.png" alt="University of Michigan School of Information" width="40" height="40" loading="lazy" /></span></span>
          <span class="tl-item__meta">M.S. in Information &middot; UCAD pathway &middot; <span class="tl-item__date"><Icon name="calendar" size={12} class="tl-item__date-icon" />starting Winter 2027</span></span>
        </div>
        <p class="tl-item__body">
          Starting the Master of Science in Information at UMSI in Winter 2027 through the UCAD pathway.
        </p>
      </li>
      <li class="tl-item">
        <div class="tl-item__head">
          <span class="tl-item__org"><Icon name="px-grad-cap" class="tl-item__icon" /><span class="tl-item__name">University of Michigan</span><span class="org-tile"><img src="/icons/companies/umich.png" alt="University of Michigan" width="40" height="40" loading="lazy" /></span></span>
          <span class="tl-item__meta">B.S.E. Robotics Engineering &middot; <span class="tl-item__date"><Icon name="calendar" size={12} class="tl-item__date-icon" />final year</span></span>
        </div>
        <p class="tl-item__body">
          I'm in my last year of the robotics engineering undergrad at the College of Engineering.
          Along the way I've led and worked on multi-person robotics and human-robot interaction
          projects: real-time experimental systems, Python automation tools, and
          software-to-hardware integrations.
        </p>
      </li>
      <li class="tl-item">
        <div class="tl-item__head">
          <a class="tl-item__org" href="https://decyphercorp.com/" target="_blank" rel="noopener"><Icon name="px-briefcase" class="tl-item__icon" /><span class="tl-item__name">Decypher</span><span class="org-tile"><img src="/icons/companies/decypher.png" alt="Decypher" width="40" height="40" loading="lazy" /></span></a>
          <span class="tl-item__meta">Software Developer Intern &middot; <span class="tl-item__date"><Icon name="calendar" size={12} class="tl-item__date-icon" />Summer 2026</span></span>
        </div>
        <p class="tl-item__body">
          This past summer I built full-stack web apps at Decypher, from the database and API up to
          the UI, using AI-assisted, spec-first tools. Most of my work was shipping data
          integrations, product features, and internal tools that took ideas to something people
          actually used.
        </p>
      </li>
      <li class="tl-item">
        <div class="tl-item__head">
          <a class="tl-item__org" href="https://www.sanhuausa.com/us/en/" target="_blank" rel="noopener"><Icon name="px-briefcase" class="tl-item__icon" /><span class="tl-item__name">Sanhua Automotive USA</span><span class="org-tile"><img src="/icons/companies/sanhua.png" alt="Sanhua Automotive USA" width="40" height="40" loading="lazy" /></span></a>
          <a class="tl-item__meta" href="/work/sanhua">Engineering Intern &middot; US Engineering Division &middot; <span class="tl-item__date"><Icon name="calendar" size={12} class="tl-item__date-icon" />May–Aug 2024</span></a>
        </div>
        <p class="tl-item__body">
          Built LabVIEW control software for a LIN-based water pump testbench, supported warranty
          analysis, and worked with engineering and sales teams on thermal-management products.
        </p>
      </li>
      <li class="tl-item">
        <div class="tl-item__head">
          <a class="tl-item__org" href="https://www.brose.com/us-en/brose-in-the-us-and-canada/" target="_blank" rel="noopener"><Icon name="px-briefcase" class="tl-item__icon" /><span class="tl-item__name">Brose North America</span><span class="org-tile"><img src="/icons/companies/brose.png" alt="Brose North America" width="40" height="40" loading="lazy" /></span></a>
          <a class="tl-item__meta" href="/work/brose">Test Release Intern &middot; Drives Division &middot; <span class="tl-item__date"><Icon name="calendar" size={12} class="tl-item__date-icon" />May–Aug 2023</span></a>
        </div>
        <p class="tl-item__body">
          Ran BLDC motor validation on DYNO systems, updated test procedures, and produced training
          materials that standardized internal workflows.
        </p>
      </li>
    </ol>
    </div>
  </section>

  <section id="about" class="section-block" data-crumb="about">
    <h2 class="section-heading">
      <Icon name="px-heart" size={20} class="section-heading__icon" /><span class="nav-index">03.</span> <span class="section-title">About</span>
    </h2>
    <p class="section-text">
      I'm a robotics engineering student at the University of Michigan who builds interactive
      systems: real-time software, embedded hardware, and the interfaces people use to work with
      them. I care about taking a project from concept to something deployed, with clean
      architecture and a front end that feels fast and considered.
    </p>
    <ul class="photo-strip">
      {photos.map((p) => (
        <li><img src={p.src} alt={p.alt} loading="lazy" /></li>
      ))}
    </ul>
  </section>

  <section id="contact" class="section-block section-block--contact" data-crumb="contact">
    <h2 class="section-heading">
      <Icon name="px-envelope" size={20} class="section-heading__icon" /><span class="nav-index">04.</span> <span class="section-title">Contact</span>
    </h2>
    <p class="section-text section-text--icon">
      <Icon name="px-envelope" class="section-text__icon" />Open to new opportunities, collaborations, and side projects. Reach out, or take a look at
      my <a href="/documents/sawyer-smith-resume.pdf" target="_blank" rel="noopener">resume</a>!
    </p>
    <div class="contact-links">
      <a class="outline-btn" href="https://github.com/partypancake8/" target="_blank" rel="noopener">
        <Icon name="github" class="icon-svg" /> GitHub
      </a>
      <a class="outline-btn" href="https://www.linkedin.com/in/sawyer-smith-60918a221/" target="_blank" rel="noopener">
        <Icon name="linkedin" class="icon-svg" /> LinkedIn
      </a>
      <a class="outline-btn" href="mailto:swyr@swyr.com">
        <Icon name="mail" class="icon-svg" /> swyr@swyr.com
      </a>
    </div>
  </section>

  <ContribGraph />
</LandingLayout>
